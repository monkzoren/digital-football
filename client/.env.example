# Local development only (`npm run dev`). Copy to .env.local and fill in.
# Docker/Compose builds do NOT read this — they get the same values as build
# args from the repo-root .env (see .env.example there).
#
# All four are public Firebase values: they identify the project, they don't
# authorize anything, and they ship in the JS bundle by design.
# Leave them unset to develop without accounts (anonymous SpacetimeDB
# identities in localStorage; ?seat=2 for a second local player).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
