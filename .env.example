# Copy to .env and adjust. Full docs: README.md "Self-hosting".
# You normally don't need to change anything: the client talks to
# SpacetimeDB same-origin (nginx proxies /v1), so there is no address to
# configure — it works on any domain, port, or TLS setup.

# SpacetimeDB database (module) name.
DATABASE_NAME=digital-football

# Host port for the web client (irrelevant behind Coolify/Traefik domains).
CLIENT_PORT=8080

# SpacetimeDB is NOT host-exposed by default (proxied via the client).
# Uncomment its ports in docker-compose.yml if you need direct access,
# then this picks the host port.
SPACETIMEDB_PORT=3000

# --- Player accounts (optional) -------------------------------------------
# Firebase Auth gives every player a STABLE identity, which is what makes XP,
# MMR and mid-match reconnect persist. Leave these empty and the game still
# works: players get anonymous SpacetimeDB identities kept in localStorage,
# so progress lives in one browser and nowhere else.
#
# Setup: create a Firebase project, enable the Anonymous and Google sign-in
# providers, add your domain under Authentication -> Settings -> Authorized
# domains, then copy the web app config here. All four are public values.
# Finally set FIREBASE_PROJECT in spacetimedb/src/index.ts to the same
# project id, so the module can tell a Firebase token from any other issuer.
#FIREBASE_API_KEY=
#FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
#FIREBASE_PROJECT_ID=your-project
#FIREBASE_APP_ID=

# Discard ALL player accounts (XP, MMR, history) if a breaking schema change
# won't publish. Empty = the publisher fails loudly instead, which is what
# you want every time except a deliberate reset.
#ALLOW_CLEAR=
