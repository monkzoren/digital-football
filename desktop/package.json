{
  "name": "digital-football-desktop",
  "productName": "Digital Football",
  "version": "1.0.1",
  "description": "Desktop client for Digital Football — GPU-accelerated regardless of browser settings",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.digitalfootball.desktop",
    "productName": "DigitalFootball",
    "files": [
      "main.js",
      "release.json"
    ],
    "protocols": [
      {
        "name": "Digital Football",
        "schemes": [
          "digitalfootball"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "DigitalFootball-Setup.exe",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "DigitalFootball.exe"
    }
  }
}
